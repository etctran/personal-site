{
  // Cloudflare Worker that serves the built site (dist/) and logs page visits.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "personal-site",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // unknown paths (like /google tracking links) serve the home page
    "not_found_handling": "single-page-application",
    // run the Worker on every request, so page visits can be logged
    "run_worker_first": true
  },
  // keep the visit lines (Observability tab in the dashboard), but not an automatic
  // row for every file the page loads
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  // lets Cloudflare build a separate test copy of every branch and pull request
  "previews": {}
}
